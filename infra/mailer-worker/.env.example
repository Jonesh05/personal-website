# infra/mailer-worker/.env.example
# Environment variables for the Railway PostgreSQL + Resend Batch Mailer Worker

# Railway Managed PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway?sslmode=require"

# Resend API Key (Server-only secret)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified Sender Identity in Resend
NEWSLETTER_FROM="jonesh.me <newsletter@mail.jonesh.me>"

# Public Site URL (used to construct https://jonesh.me/preferences?token={magicToken})
NEXT_PUBLIC_SITE_URL="https://jonesh.me"

# Segmentation & Batching Configuration
# Leave TARGET_TAG empty to dispatch to all active subscribers
TARGET_TAG=""
BATCH_SIZE="75"
BATCH_DELAY_MS="1000"
EDITION_NUMBER="1"
DRY_RUN="false"
