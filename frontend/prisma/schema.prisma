// frontend/prisma/schema.prisma
// Execution Layer — Newsletter & Segmentation Data Model (PostgreSQL on Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriberStatus {
  pending
  active
  unsubscribed
}

model Subscriber {
  id         String           @id @default(uuid()) @db.Uuid
  email      String           @unique
  status     SubscriberStatus @default(active)
  tags       String[]         @default([])
  magicToken String           @unique @default(uuid()) @db.Uuid
  source     String           @default("blog-sidebar")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status])
  @@index([tags], type: Gin)
  @@map("subscribers")
}
